rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.createdAt is string;
    }

    function isValidAnalyzedOffer(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'price', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'url', 'price', 'estimatedMarketPrice', 'verdict', 'dealScore', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 256
        && (!('url' in data) || (data.url is string && data.url.size() <= 1024))
        && data.price is number
        && (!('estimatedMarketPrice' in data) || data.estimatedMarketPrice is number)
        && (!('verdict' in data) || (data.verdict is string && data.verdict in ['BIERZ TERAZ', 'NEGOCJUJ', 'SZUKAJ DALEJ', 'NIEOPŁACALNE']))
        && (!('dealScore' in data) || data.dealScore is number)
        && data.createdAt is string;
    }

    function isValidPriceAlert(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'targetPrice', 'currentPrice', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'targetPrice', 'currentPrice', 'originalPrice', 'url', 'active', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 256
        && data.targetPrice is number
        && data.currentPrice is number
        && (!('originalPrice' in data) || data.originalPrice is number)
        && (!('url' in data) || (data.url is string && data.url.size() <= 1024))
        && (!('active' in data) || data.active is bool)
        && data.createdAt is string;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'role', 'content', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'role', 'content', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.role is string && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() <= 2048
        && data.createdAt is string;
    }

    // Public test document for connection check
    match /test/{docId} {
      allow get: if true;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User's Analyzed Offers Subcollection
      match /offers/{offerId} {
        allow get, list: if isOwner(userId) && isValidId(offerId);
        allow create: if isOwner(userId) && isValidId(offerId) && isValidAnalyzedOffer(incoming());
        allow update: if isOwner(userId) && isValidId(offerId) && isValidAnalyzedOffer(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(offerId);
      }

      // User's Price Alerts Subcollection
      match /alerts/{alertId} {
        allow get, list: if isOwner(userId) && isValidId(alertId);
        allow create: if isOwner(userId) && isValidId(alertId) && isValidPriceAlert(incoming());
        allow update: if isOwner(userId) && isValidId(alertId) && isValidPriceAlert(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(alertId);
      }

      // User's Shopping Advisor Chat History Subcollection
      match /chats/{chatId} {
        allow get, list: if isOwner(userId) && isValidId(chatId);
        allow create: if isOwner(userId) && isValidId(chatId) && isValidChatMessage(incoming());
        allow update: if isOwner(userId) && isValidId(chatId) && isValidChatMessage(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(chatId);
      }
    }
  }
}
